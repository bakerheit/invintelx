# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3001

# Local Mongo from docker-compose (single-node replica set)
MONGODB_URI=mongodb://localhost:27017/invintelx?replicaSet=rs0
MONGODB_DB=invintelx

# 32+ char random string. Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Where the web app is served from, used for cookie + CORS decisions in production
WEB_ORIGIN=http://localhost:5173

# Where the built web app lives. Leave unset and the API looks in apps/web/dist,
# which is where `pnpm build` puts it — so a normal build needs nothing here.
# Set it when the layout differs (a container that copies the assets elsewhere).
# A directory with no index.html in it is a boot failure, not a warning.
# Serving nothing at all is also valid: unset this, do not build the web app,
# and put a reverse proxy in front that serves the assets itself.
#WEB_DIST=/srv/invintelx/web

# How this instance gets its first administrator.
#
#   token (default) — the API mints a setup token at boot while the instance has
#                     no accounts and prints it to its log. Registration will not
#                     create an administrator without it, so deploying the
#                     instance and claiming it are two separate acts.
#   open            — the first account to register becomes the administrator,
#                     with no token. Only sensible for a public sign-up product;
#                     on anything reachable from the internet it means whoever
#                     finds it first owns your inventory system.
FIRST_ADMIN_SETUP=token

# Optional. Pin the setup token instead of reading it out of the log — useful
# when the log is awkward to reach but a secret is easy to inject. 16+ chars.
# Ignored once the instance has an account.
# SETUP_TOKEN=

# Logging. See docs/observability.md.
#
# LOG_LEVEL  — lowest level written: trace, debug, info, warn, error, fatal, or
#              silent. Defaults to info, and to silent under NODE_ENV=test.
#              debug adds health probes and static asset requests, which are
#              deliberately quiet at the default because a platform polls the
#              health endpoint every few seconds forever.
# LOG_FORMAT — json or pretty. Unset means json in production and pretty
#              everywhere else, which is right in both places. Set it when the
#              deployment disagrees: a staging container somebody tails wants
#              pretty, and a developer debugging their log pipeline wants json.
#
# Passwords, session tokens and cookies are stripped from every line before it
# is written, whatever these are set to.
#LOG_LEVEL=info
#LOG_FORMAT=json

# AGPL section 13: the running app must offer its source to network users.
# If you modify InvIntelX and serve it to other people, point this at YOUR
# source, not ours — otherwise your deployment is not compliant.
VITE_SOURCE_URL=https://github.com/bakerheit/invintelx
