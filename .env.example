# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3001

# Local Mongo from docker-compose (single-node replica set)
MONGODB_URI=mongodb://localhost:27017/invintelx?replicaSet=rs0
MONGODB_DB=invintelx

# 32+ char random string. Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Where the web app is served from, used for cookie + CORS decisions in production
WEB_ORIGIN=http://localhost:5173

# Where the built web app lives. Leave unset and the API looks in apps/web/dist,
# which is where `pnpm build` puts it — so a normal build needs nothing here.
# Set it when the layout differs (a container that copies the assets elsewhere).
# A directory with no index.html in it is a boot failure, not a warning.
# Serving nothing at all is also valid: unset this, do not build the web app,
# and put a reverse proxy in front that serves the assets itself.
#WEB_DIST=/srv/invintelx/web

# AGPL section 13: the running app must offer its source to network users.
# If you modify InvIntelX and serve it to other people, point this at YOUR
# source, not ours — otherwise your deployment is not compliant.
VITE_SOURCE_URL=https://github.com/bakerheit/invintelx
