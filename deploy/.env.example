# Copy to .env next to docker-compose.yml and edit. Never commit .env.
#
# This is the deployment's configuration. The repository root has its own
# .env.example for running from a dev checkout; that one is not this one, and
# the variables that differ are the ones that matter.
#
# docker-compose.yml sets NODE_ENV, PORT and MONGODB_URI itself — they describe
# the stack rather than a choice, so setting them here does nothing.

# Which release to run. Change this and `docker compose up -d` to upgrade;
# read the CHANGELOG for the versions you are stepping over before you do.
# Pin a version rather than tracking :latest once the instance holds real data.
INVINTELX_IMAGE=ghcr.io/bakerheit/invintelx:latest

# REQUIRED. 32+ character random string, and it must not change: every session
# in the database is invalidated if it does. Generate one with
#   openssl rand -base64 32
SESSION_SECRET=

# REQUIRED. The public URL browsers use to reach this instance, scheme and all.
# https:// in front of a TLS terminator, not the loopback address the container
# is bound to.
WEB_ORIGIN=https://invintelx.example.com

# The database name inside the Mongo container. Changing it after first boot
# points the app at an empty database; it does not move your data.
MONGODB_DB=invintelx

# How this instance gets its first administrator.
#
#   token (default) — the API mints a setup token at boot while the instance
#                     has no accounts and prints it to its log. Read it with
#                     `docker compose logs app`. Registration will not create
#                     an administrator without it, so deploying the instance
#                     and claiming it stay two separate acts.
#   open            — the first account to register becomes the administrator,
#                     with no token. On anything reachable from the internet
#                     that means whoever finds it first owns your inventory.
FIRST_ADMIN_SETUP=token

# Optional. Pin the setup token instead of reading it out of the log. 16+
# characters. Ignored once the instance has an account.
#
# Leave it commented out rather than set to an empty string: an empty value is
# a value, and the API refuses to boot on one that is too short.
#SETUP_TOKEN=

# AGPL section 13. Only relevant if you build your own image: the value is
# compiled into the web bundle, so setting it here has no effect on a pulled
# one. If you modify InvIntelX and serve it to other people, build with
#   docker build --build-arg VITE_SOURCE_URL=https://your.host/your-fork .
# and point it at your source.
